# Copy to .env and adjust. Nothing here is a real secret — dev-only defaults
# that match docker-compose.yml. Change before any non-local deployment.

# --- Postgres --------------------------------------------------------------
# Host-mapped port is 5433, not Postgres's usual 5432 — see docker-compose.yml
# for why (a pre-existing native Postgres service on some dev machines wins
# port 5432 and silently shadows the container). Container-to-container
# traffic (Presto, Hive Metastore) is unaffected — it uses the internal
# Docker network on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=ulpf_dev_only
POSTGRES_META_DB=ulpf_meta

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ulpfadmin
MINIO_SECRET_KEY=ulpf_dev_only
MINIO_RAW_BUCKET=ulpf-raw
MINIO_LAKE_BUCKET=ulpf-lake
MINIO_USE_SSL=false

# --- Kafka ---------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC_RAW_REFS=ulpf.raw.refs
KAFKA_TOPIC_NORMALIZED=ulpf.events.normalized
KAFKA_TOPIC_DLQ=ulpf.dlq
KAFKA_TOPIC_CONTROL_PARSERS=ulpf.control.parsers

# --- Presto ---------------------------------------------------------------
PRESTO_HOST=localhost
PRESTO_PORT=8080
PRESTO_USER=ulpf

# --- Collector listeners ---------------------------------------------------
ULPF_SYSLOG_UDP_ADDR=:5514
ULPF_SYSLOG_TCP_ADDR=:6601
ULPF_SYSLOG_TLS_ADDR=:6614
ULPF_HTTP_ADDR=:8088
ULPF_TLS_CERT=deploy/certs/server.crt
ULPF_TLS_KEY=deploy/certs/server.key

# --- Control plane ---------------------------------------------------------
ULPF_API_ADDR=:8000
ULPF_JWT_SECRET=change_me_dev_only
ULPF_DB_URL=postgresql+psycopg2://ulpf:ulpf_dev_only@localhost:5433/ulpf_meta
ULPF_DEV_SQLITE_URL=sqlite:///./ulpf_dev.db

# --- Vault ---------------------------------------------------------------
ULPF_VAULT_SEGMENT_MAX_BYTES=67108864
ULPF_VAULT_SEGMENT_MAX_SECONDS=300
