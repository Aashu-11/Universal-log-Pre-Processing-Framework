# Copy to .env and adjust. Nothing here is a real secret — dev-only defaults
# that match docker-compose.yml. Change before any non-local deployment.

# --- Postgres --------------------------------------------------------------
# Host-mapped port is 5433, not Postgres's usual 5432 — see docker-compose.yml
# for why (a pre-existing native Postgres service on some dev machines wins
# port 5432 and silently shadows the container). Container-to-container
# traffic (Presto, Hive Metastore) is unaffected — it uses the internal
# Docker network on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=logkrama
POSTGRES_PASSWORD=logkrama_dev_only
POSTGRES_META_DB=logkrama_meta

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=logkramaadmin
MINIO_SECRET_KEY=logkrama_dev_only
MINIO_RAW_BUCKET=logkrama-raw
MINIO_LAKE_BUCKET=logkrama-lake
MINIO_USE_SSL=false

# --- Kafka ---------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC_RAW_REFS=logkrama.raw.refs
KAFKA_TOPIC_NORMALIZED=logkrama.events.normalized
KAFKA_TOPIC_DLQ=logkrama.dlq
KAFKA_TOPIC_CONTROL_PARSERS=logkrama.control.parsers

# --- Presto ---------------------------------------------------------------
PRESTO_HOST=localhost
PRESTO_PORT=8080
PRESTO_USER=logkrama

# --- Collector listeners ---------------------------------------------------
LOGKRAMA_SYSLOG_UDP_ADDR=:5514
LOGKRAMA_SYSLOG_TCP_ADDR=:6601
LOGKRAMA_SYSLOG_TLS_ADDR=:6614
LOGKRAMA_HTTP_ADDR=:8088
LOGKRAMA_TLS_CERT=deploy/certs/server.crt
LOGKRAMA_TLS_KEY=deploy/certs/server.key

# --- Control plane ---------------------------------------------------------
LOGKRAMA_API_ADDR=:8000
LOGKRAMA_JWT_SECRET=change_me_dev_only
LOGKRAMA_DB_URL=postgresql+psycopg2://logkrama:logkrama_dev_only@localhost:5433/logkrama_meta
LOGKRAMA_DEV_SQLITE_URL=sqlite:///./logkrama_dev.db

# --- Vault ---------------------------------------------------------------
LOGKRAMA_VAULT_SEGMENT_MAX_BYTES=67108864
LOGKRAMA_VAULT_SEGMENT_MAX_SECONDS=300
